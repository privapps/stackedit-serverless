{
  "name": "stackedit",
  "version": "5.15.4",
  "description": "Free, open-source, full-featured Markdown editor",
  "author": "Benoit Schweblin",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/privapps/stackedit-serverless/issues"
  },
  "scripts": {
    "postinstall": "node build/build-prism.js",
    "start": "node build/dev-server.js",
    "build": "node build/build.js && npm run build-style",
    "build-style": "webpack --config build/webpack.style.conf.js",
    "lint": "eslint src",
    "unit": "vitest run --config vitest.config.mjs",
    "unit-with-coverage": "vitest run --config vitest.config.mjs --coverage",
    "test": "npm run lint && npm run unit",
    "browser-smoke": "node test/browser-smoke.cjs",
    "preversion": "npm run test",
    "patch": "npm version patch -m \"Tag v%s\"",
    "minor": "npm version minor -m \"Tag v%s\"",
    "major": "npm version major -m \"Tag v%s\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@vue/compat": "^3.5.43",
    "abcjs": "^6.0.0",
    "bezier-easing": "^1.1.0",
    "clipboard": "^1.7.1",
    "core-js": "^3.41.0",
    "diff-match-patch": "^1.0.0",
    "dompurify": "^3.4.16",
    "file-saver": "^1.3.8",
    "handlebars": "^4.1.2",
    "indexeddbshim": "^19.0.7",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.1",
    "markdown-it-abbr": "^1.0.4",
    "markdown-it-deflist": "^2.0.2",
    "markdown-it-emoji": "^1.3.0",
    "markdown-it-footnote": "^3.0.1",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-mark": "^2.0.0",
    "markdown-it-pandoc-renderer": "1.2.0",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "mermaid": "^12.1.0",
    "mousetrap": "^1.6.1",
    "normalize-scss": "^7.0.1",
    "prismjs": "^1.6.0",
    "regenerator-runtime": "^0.14.1",
    "turndown": "^7.2.4",
    "vue": "^3.5.43",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.5.0",
    "fake-indexeddb": "^6.2.5",
    "favicons": "^7.2.0",
    "favicons-webpack-plugin": "^6.0.1",
    "file-loader": "^6.2.0",
    "globals": "^16.4.0",
    "html-webpack-plugin": "^5.6.3",
    "ignore-loader": "^0.1.2",
    "jsdom": "^27.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.3",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "raw-loader": "^4.0.2",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "semver": "^7.8.5",
    "string-replace-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.3.14",
    "url-loader": "^4.1.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.0.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "overrides": {
    "katex": "^0.19.0",
    "sqlite3": "^6.0.1",
    "workbox-build": {
      "glob": "^13.0.6"
    }
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
